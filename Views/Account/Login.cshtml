@model Software_and_Database_Security___Project.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    /* Material 3 Filled Text Field */
    .md-text-field {
        background-color: var(--md-sys-color-surface-container-low);
        border-radius: 12px 12px 0 0;
        border: none;
        border-bottom: 2px solid var(--md-sys-color-outline);
        height: 56px;
        padding: 0.75rem 1rem;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }
    .md-text-field:focus {
        background-color: #dfd7e6;
        border-bottom: 2px solid var(--md-sys-color-primary);
        box-shadow: none;
        outline: none;
    }
</style>

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-lg-10 col-xl-9">
        <div class="md-card p-0 overflow-hidden shadow-lg" style="border-radius: 36px; background-color: var(--md-sys-color-surface-container);">
            <div class="row g-0">
                <!-- Cột trái: Tonal Accent Panel -->
                <div class="col-md-5 p-5 d-flex flex-column justify-content-between" style="background-color: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary);">
                    <div>
                        <div class="d-inline-flex p-3 rounded-circle mb-4" style="background-color: rgba(255, 255, 255, 0.15);">
                            <i class="bi bi-fingerprint fs-2"></i>
                        </div>
                        <h2 class="fw-bold mb-2">Chào mừng trở lại!</h2>
                        <p class="small text-white-50">Cổng đăng nhập học tập bảo mật đa tầng, khóa phiên đăng nhập tự động khi phát hiện tấn công brute-force.</p>
                    </div>

                    <div class="p-3 rounded-4 mt-4" style="background-color: rgba(255, 255, 255, 0.12); backdrop-filter: blur(10px);">
                        <div class="small fw-bold mb-1"><i class="bi bi-info-circle me-1"></i> Tài khoản kiểm thử:</div>
                        <div class="small text-white-50">Mật khẩu: <span class="badge bg-light text-dark rounded-pill">SecurePass@123</span></div>
                        <ul class="list-unstyled small mt-2 mb-0 text-white-50">
                            <li>• <strong>Admin:</strong> admin@lms.com</li>
                            <li>• <strong>Giảng viên:</strong> teacher1@lms.com</li>
                            <li>• <strong>Sinh viên:</strong> student1@lms.com</li>
                        </ul>
                    </div>
                </div>

                <!-- Cột phải: Form nhập chuẩn MD3 -->
                <div class="col-md-7 p-5 bg-white">
                    <h3 class="fw-bold mb-1" style="color: var(--md-sys-color-on-background);">Đăng nhập tài khoản</h3>
                    <p class="text-muted small mb-4">Vui lòng nhập email và mật khẩu của bạn</p>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 small py-2 mb-3 border-0"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-bold text-muted">Email</label>
                            <input asp-for="Email" class="form-control md-text-field" placeholder="ten@lms.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label small fw-bold text-muted">Mật khẩu</label>
                            <input asp-for="Password" type="password" class="form-control md-text-field" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input rounded-3" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted">Ghi nhớ đăng nhập</label>
                        </div>

                        <button type="submit" class="md-btn md-btn-filled w-100 py-3">
                            Đăng nhập <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>