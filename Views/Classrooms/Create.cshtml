@{
    ViewData["Title"] = "Mở Lớp Học Mới";
}

<style>
    .md-text-field {
        background-color: var(--md-sys-color-surface-container-low);
        border-radius: 12px 12px 0 0;
        border: none;
        border-bottom: 2px solid var(--md-sys-color-outline);
        height: 56px;
        padding: 0.75rem 1rem;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }
    .md-text-field:focus {
        background-color: #dfd7e6;
        border-bottom: 2px solid var(--md-sys-color-primary);
        box-shadow: none;
        outline: none;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="md-card shadow-sm p-4 p-md-5" style="border-radius: 32px;">
            <div class="d-inline-flex p-3 rounded-circle mb-3" style="background-color: var(--md-sys-color-primary-container); color: var(--md-sys-color-primary);">
                <i class="bi bi-mortarboard fs-3"></i>
            </div>
            <h3 class="fw-bold mb-1">Mở Lớp Học Mới</h3>
            <p class="text-muted small mb-4">Gán giảng viên phụ trách theo nguyên tắc kiểm soát truy cập</p>

            <form asp-action="Create" method="post">
                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted">Tên lớp học</label>
                    <input name="name" class="form-control md-text-field" placeholder="Ví dụ: Lập trình An toàn Web - Nhóm 1" required />
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted">Chỉ định Giảng viên</label>
                    <select name="teacherId" asp-items="ViewBag.Teachers" class="form-select md-text-field" required>
                        <option value="">-- Chọn giảng viên từ danh sách --</option>
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="md-btn md-btn-outlined w-50">Hủy bỏ</a>
                    <button type="submit" class="md-btn md-btn-filled w-50">Lưu lớp học</button>
                </div>
            </form>
        </div>
    </div>
</div>