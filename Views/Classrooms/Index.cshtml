@model IEnumerable<Software_and_Database_Security___Project.Models.Classroom>
@{
    ViewData["Title"] = "Quản lý Lớp học";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="md-chip mb-2" style="background-color: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container);">
            <i class="bi bi-shield-lock-fill"></i> Quyền Quản trị viên
        </span>
        <h2 class="fw-bold mb-0" style="color: var(--md-sys-color-on-surface);">Quản lý Danh sách Lớp học</h2>
    </div>
    <a asp-action="Create" class="md-btn md-btn-filled shadow-sm">
        <i class="bi bi-plus-lg"></i> Tạo Lớp Mới
    </a>
</div>

<div class="md-card p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color: var(--md-sys-color-surface-container-high);">
                <tr class="small text-muted text-uppercase">
                    <th class="ps-4 py-3">Mã Lớp</th>
                    <th class="py-3">Tên Khóa Học</th>
                    <th class="py-3">Giảng viên Phụ trách</th>
                    <th class="py-3">Sĩ số</th>
                    <th class="text-end pe-4 py-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-folder-x display-6 d-block mb-2"></i> Chưa có lớp học nào được tạo.
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-muted">#@c.Id</td>
                        <td><span class="fw-bold fs-6" style="color: var(--md-sys-color-primary);">@c.Name</span></td>
                        <td>
                            <div class="fw-medium">@(c.Teacher?.FullName ?? "Chưa phân công")</div>
                            <small class="text-muted">@c.Teacher?.Email</small>
                        </td>
                        <td>
                            <span class="md-chip bg-white border shadow-sm">
                                <i class="bi bi-people-fill text-muted me-1"></i> @c.Enrollments.Count học viên
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@c.Id" class="md-btn md-btn-tonal py-1 px-3">
                                <i class="bi bi-person-gear"></i> Ghi danh
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>