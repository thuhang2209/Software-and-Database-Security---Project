@model Software_and_Database_Security___Project.Models.Classroom
@{
    ViewData["Title"] = "Chi tiết Lớp học";
}
<div class="container mt-4">
    <h3>Lớp: @Model.Name</h3>
    <p><strong>Giảng viên phụ trách:</strong> @Model.Teacher?.FullName</p>
    <hr />

    <div class="row">
        <div class="col-md-7">
            <h5>Danh sách học viên đã ghi danh (@Model.Enrollments.Count)</h5>
            <ul class="list-group">
                @foreach (var e in Model.Enrollments)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @e.Student?.FullName (@e.Student?.Email)
                        <span class="badge bg-success">Đã ghi danh</span>
                    </li>
                }
            </ul>
        </div>
        <div class="col-md-5">
            <div class="card p-3">
                <h5>Thêm học viên vào lớp</h5>
                <form asp-action="EnrollStudent" method="post">
                    <input type="hidden" name="classId" value="@Model.Id" />
                    <div class="mb-3">
                        <select name="studentId" class="form-select" required>
                            <option value="">-- Chọn sinh viên --</option>
                            @foreach (var s in (IEnumerable<ApplicationUser>)ViewBag.AvailableStudents)
                            {
                                <option value="@s.Id">@s.FullName (@s.Email)</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ghi danh</button>
                </form>
            </div>
        </div>
    </div>
</div>