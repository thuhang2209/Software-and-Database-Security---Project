@model Software_and_Database_Security___Project.Models.Lesson
@{
    ViewData["Title"] = Model.Title;
}

<div class="md-card p-4 p-md-5 mb-4 shadow-sm" style="border-radius: 32px;">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-3">
        <div>
            <span class="md-chip @(Model.IsPublished ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis") mb-2">
                <i class="bi @(Model.IsPublished ? "bi-check-circle" : "bi-lock")"></i> @(Model.IsPublished ? "Đã xuất bản" : "Bản nháp (Draft)")
            </span>
            <h2 class="fw-bold" style="color: var(--md-sys-color-on-surface);">@Model.Title</h2>
            <div class="small text-muted">Lớp học: <strong>@Model.Classroom?.Name</strong> | Giảng viên: <strong>@Model.Classroom?.Teacher?.FullName</strong></div>
        </div>
        <a asp-action="Index" asp-route-classId="@Model.ClassroomId" class="md-btn md-btn-outlined">Quay lại danh sách</a>
    </div>

    <!-- Nội dung bài học (HTML Encoded chống XSS) -->
    <div class="p-4 rounded-4 mt-3 bg-white border" style="white-space: pre-wrap; line-height: 1.7;">@Model.Content</div>

    <!-- Nút tải tài liệu đính kèm nếu có -->
    @if (!string.IsNullOrEmpty(Model.AttachmentFilePath))
    {
        <div class="mt-4 p-3 rounded-4 d-flex justify-content-between align-items-center" style="background-color: var(--md-sys-color-secondary-container);">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-file-earmark-arrow-down fs-2" style="color: var(--md-sys-color-primary);"></i>
                <div>
                    <div class="fw-bold">@Model.AttachmentFileName</div>
                    <small class="text-muted">Tài liệu học tập đính kèm từ Giảng viên</small>
                </div>
            </div>
            <a asp-action="DownloadFile" asp-route-lessonId="@Model.Id" class="md-btn md-btn-filled">
                <i class="bi bi-download"></i> Tải về máy
            </a>
        </div>
    }
</div>

<!-- Khu vực Bài tập về nhà & Bài kiểm tra -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-clipboard-check-fill me-2" style="color: var(--md-sys-color-primary);"></i>Bài tập & Bài kiểm tra</h4>
    @if (User.IsInRole("Teacher"))
    {
        <button class="md-btn md-btn-tonal" data-bs-toggle="collapse" data-bs-target="#createAssignmentBox">
            <i class="bi bi-plus-circle"></i> Thêm Bài tập / Kiểm tra
        </button>
    }
</div>

<!-- Hộp thoại tạo Bài tập/Kiểm tra dành riêng cho Teacher -->
@if (User.IsInRole("Teacher"))
{
    <div class="collapse mb-4" id="createAssignmentBox">
        <div class="md-card p-4 shadow-sm" style="border-radius: 24px; background-color: var(--md-sys-color-surface-container-high);">
            <h5 class="fw-bold mb-3">Tạo mới Bài tập về nhà hoặc Bài kiểm tra</h5>
            <form asp-action="CreateAssignment" method="post">
                <input type="hidden" name="lessonId" value="@Model.Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Tiêu đề bài làm</label>
                        <input name="title" class="form-control rounded-pill px-3" placeholder="Ví dụ: BTVN Tuần 2 / Kiểm tra 15 phút" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Loại bài</label>
                        <select name="assignmentType" class="form-select rounded-pill px-3">
                            <option value="Homework">Bài tập về nhà (BTVN)</option>
                            <option value="Quiz">Bài kiểm tra (Quiz/Exam)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Hạn nộp</label>
                        <input type="datetime-local" name="deadline" class="form-control rounded-pill px-3" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted">Hướng dẫn & Yêu cầu đề bài</label>
                        <textarea name="instructions" class="form-control rounded-4 p-3" rows="3" placeholder="Nhập câu hỏi, bài tập hoặc yêu cầu thực hành..." required></textarea>
                    </div>
                    <div class="col-12 text-end">
                        <button type="submit" class="md-btn md-btn-filled px-4">Tạo bài ngay</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

<!-- Danh sách Bài tập / Kiểm tra -->
<div class="d-flex flex-column gap-3">
    @if (!Model.Assignments.Any())
    {
        <div class="md-card p-4 text-center text-muted small">
            Bài học này hiện chưa có bài tập hoặc bài kiểm tra nào.
        </div>
    }
    @foreach (var asm in Model.Assignments)
    {
        <div class="md-card p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    @if (asm.AssignmentType == "Quiz")
                    {
                        <span class="md-chip bg-danger-subtle text-danger"><i class="bi bi-stopwatch"></i> BÀI KIỂM TRA</span>
                    }
                    else
                    {
                        <span class="md-chip bg-primary-subtle text-primary"><i class="bi bi-pencil"></i> BTVN</span>
                    }
                    <h5 class="fw-bold mb-0">@asm.Title</h5>
                </div>
                <small class="text-muted">
                    <i class="bi bi-clock me-1"></i> Hạn nộp: @(asm.Deadline.HasValue ? asm.Deadline.Value.ToString("dd/MM/yyyy HH:mm") : "Không giới hạn")
                    | Đã nộp: <strong>@asm.Submissions.Count</strong> bài
                </small>
            </div>
            <div>
                @if (User.IsInRole("Student"))
                {
                    <a asp-controller="Submissions" asp-action="Submit" asp-route-assignmentId="@asm.Id" class="md-btn md-btn-filled">
                        <i class="bi bi-send"></i> Nộp bài làm
                    </a>
                }
                @if (User.IsInRole("Teacher"))
                {
                    <a asp-controller="Submissions" asp-action="Index" asp-route-assignmentId="@asm.Id" class="md-btn md-btn-tonal">
                        <i class="bi bi-card-checklist"></i> Xem ai đã nộp & Phản hồi
                    </a>
                }
            </div>
        </div>
    }
</div>