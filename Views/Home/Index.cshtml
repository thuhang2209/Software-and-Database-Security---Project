@model IEnumerable<Software_and_Database_Security___Project.Models.Classroom>
@{
    ViewData["Title"] = "Không gian Học tập";
}

<!-- Hero Section với góc bo siêu lớn 48px và nền Primary Container -->
<div class="p-5 mb-5 shadow-sm position-relative overflow-hidden" 
     style="border-radius: 48px; background: linear-gradient(135deg, var(--md-sys-color-primary-container) 0%, #f4e8ff 100%);">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="md-chip mb-3 bg-white text-dark shadow-sm">
                <i class="bi bi-shield-check" style="color: var(--md-sys-color-primary);"></i> Zero Trust & RBAC Enabled
            </span>
            <h1 class="display-6 fw-bold" style="color: var(--md-sys-color-on-primary-container);">Hệ thống Quản lý Học tập</h1>
            <p class="lead mb-0 text-muted fs-6">Quản lý khóa học, tài liệu, bài tập và hoạt động học tập theo vai trò và quyền truy cập.</p>
        </div>
        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Classrooms" asp-action="Create" class="md-btn md-btn-filled shadow">
                    <i class="bi bi-plus-lg"></i> Mở Lớp Học Mới
                </a>
            }
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color: var(--md-sys-color-on-background);">
        <i class="bi bi-journal-bookmark-fill me-2" style="color: var(--md-sys-color-primary);"></i>Khóa học của bạn
    </h4>
    <span class="md-chip" style="background-color: var(--md-sys-color-secondary-container);">
        @(Model?.Count() ?? 0) khóa học
    </span>
</div>

@if (Model == null || !Model.Any())
{
    <div class="md-card p-5 text-center">
        <i class="bi bi-inbox display-4 text-muted mb-2"></i>
        <h5 class="fw-bold">Bạn chưa thuộc lớp học nào</h5>
        <p class="text-muted small mb-0">Vui lòng liên hệ quản trị viên để được phân quyền ghi danh vào lớp tương ứng[cite: 14].</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="md-card md-card-interactive h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="md-chip bg-white shadow-sm" style="color: var(--md-sys-color-primary);">
                                <i class="bi bi-mortarboard me-1"></i> Khóa học
                            </span>
                            <small class="text-muted"><i class="bi bi-people me-1"></i>@c.Enrollments.Count học viên</small>
                        </div>

                        <h5 class="fw-bold mb-2" style="color: var(--md-sys-color-on-surface);">@c.Name</h5>
                        <p class="small text-muted mb-4">
                            Giảng viên: <strong>@(c.Teacher?.FullName ?? "Chưa chỉ định")</strong>
                        </p>
                    </div>

                    <a asp-controller="Lessons" asp-action="Index" asp-route-classId="@c.Id" class="md-btn md-btn-tonal w-100">
                        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                            {
                                <span>Truy cập</span> <i class="bi bi-arrow-right ms-1"></i>
                            }
                            else
                            {
                                <span>Vào học ngay</span> <i class="bi bi-arrow-right ms-1"></i>
                            }   
                    </a>
                </div>
            </div>
        }
    </div>
}