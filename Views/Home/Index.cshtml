@model IEnumerable<Software_and_Database_Security___Project.Models.Classroom>
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="p-4 p-md-5 mb-4 rounded-4 text-white shadow-sm" style="background: var(--primary-gradient);">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-6 fw-bold">Không gian Học tập & Đào tạo</h1>
            <p class="lead mb-0 text-white-50">Xem các khóa học, theo dõi bài tập và nhận đánh giá từ giảng viên với quyền truy cập bảo mật cao.</p>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Classrooms" asp-action="Create" class="btn btn-light rounded-pill px-4 fw-bold shadow">
                    <i class="bi bi-plus-circle me-1"></i> Mở Lớp Mới
                </a>
            }
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-collection-play me-2 text-primary"></i>Lớp học khả dụng của bạn</h4>
    <span class="text-muted small">Hiển thị @(Model?.Count() ?? 0) lớp học</span>
</div>

@if (Model == null || !Model.Any())
{
    <div class="custom-card p-5 text-center">
        <i class="bi bi-folder2-open display-3 text-muted"></i>
        <h5 class="mt-3 text-dark fw-bold">Bạn chưa thuộc lớp học nào</h5>
        <p class="text-muted mb-0 small">Vui lòng liên hệ Admin để được cấp quyền ghi danh vào lớp đào tạo tương ứng.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="custom-card custom-card-hover h-100 d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
                            <i class="bi bi-book-half me-1"></i> Khóa học
                        </span>
                        <div class="text-muted small"><i class="bi bi-people-fill me-1"></i>@c.Enrollments.Count học viên</div>
                    </div>

                    <h5 class="fw-bold text-dark mb-2">@c.Name</h5>
                    <p class="text-muted small mb-4 flex-grow-1">
                        <i class="bi bi-person-badge me-1"></i> Giảng viên: <strong>@(c.Teacher?.FullName ?? "Chưa phân công")</strong>
                    </p>

                    <a asp-controller="Lessons" asp-action="Index" asp-route-classId="@c.Id" class="btn btn-outline-primary rounded-pill w-100 fw-semibold">
                        Truy cập lớp học <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}